# 이 파일을 .env.local 로 복사해서 채운다 (.env.local 은 git 에 안 올라감).
# 값은 여기에도, 커밋에도, 문서에도 적지 않는다 (요구사항 §10.11).

# ── 브라우저로 나가는 값 ─────────────────────────────────────────────────────
# VITE_ 접두사가 붙은 것만 번들에 들어간다. 공개돼도 되는 값만 여기에 둔다.
# Supabase 대시보드 → Project Settings → API Keys
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── 브라우저로 나가면 안 되는 값 ─────────────────────────────────────────────
# 수집 스크립트에서만 쓴다. **절대 VITE_ 접두사를 붙이지 말 것** — 붙이는 순간
# 번들에 인라인되어 공개된다.

# developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키
# (키만으론 부족하다: [카카오맵] → [사용 설정] 을 ON 으로 바꿔야 로컬 API 가 열린다)
# 쓰는 곳: 식당 풀 반경 수집(FD6), 사무실 주소 → 좌표
KAKAO_REST_API_KEY=

# openapi.sk.com → 프로젝트 생성 → appKey
# 쓰는 곳: 사무실 → 식당 보행자 도보 시간 (매일 1회 재계산)
TMAP_APP_KEY=

# ── Supabase 인증 설정용 (supabase config push 가 읽는다) ────────────────────
# Google Cloud Console → 사용자 인증 정보 → OAuth 2.0 클라이언트 ID (웹 애플리케이션)
# 승인된 리디렉션 URI: https://<project-ref>.supabase.co/auth/v1/callback
# 자세한 절차는 docs/auth-setup.md
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ── 로컬 도구(Supabase CLI)용 ────────────────────────────────────────────────
# 브라우저로도, 앱으로도 나가지 않는다. 마이그레이션·인증 설정을 적용할 때만 쓴다.

# supabase.com/dashboard/account/tokens → 토큰 발급 (sbp_… )
SUPABASE_ACCESS_TOKEN=

# Project Settings → Database → Database password (모르면 재설정)
SUPABASE_DB_PASSWORD=
